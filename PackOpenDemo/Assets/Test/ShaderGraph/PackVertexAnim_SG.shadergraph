{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3469e8557102297686f42c47901bea07",
    "m_Title": "How to read this graph",
    "m_Content": "Left to right: UV and pivot -> deltas -> six independent terms (skew, bend, wave) -> sum per axis -> added to the vertex position. Compare with Assets/Shaders/PackVertexAnim.shader (vert function). Needs UIMeshSubdivide on the Image for bend and wave. Differences: no stencil or clip-rect, no _Color tint.",
    "m_TextSize": 0,
    "m_Theme": 1,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2900.0,
        "y": -1650.0,
        "width": 640.0,
        "height": 140.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

